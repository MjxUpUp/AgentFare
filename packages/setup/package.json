{
  "name": "@agentfare/setup",
  "version": "0.2.1",
  "description": "Auto-detection and setup tooling for AgentFare",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentfare-setup": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./detector": {
      "types": "./dist/detector.d.ts",
      "import": "./dist/detector.js",
      "default": "./dist/detector.js"
    },
    "./shell-writer": {
      "types": "./dist/shell-writer.d.ts",
      "import": "./dist/shell-writer.js",
      "default": "./dist/shell-writer.js"
    },
    "./validator": {
      "types": "./dist/validator.d.ts",
      "import": "./dist/validator.js",
      "default": "./dist/validator.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js",
      "default": "./dist/reporter.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MjxUpUp/AgentFare.git",
    "directory": "packages/setup"
  },
  "scripts": {
    "build": "tsc",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentfare/models": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.8",
    "vitest": "^3.2"
  }
}
