{
  "name": "@agentfare/cli",
  "version": "0.2.1",
  "description": "Command-line interface for AgentFare cost optimization",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentfare": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js",
      "default": "./dist/commands/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MjxUpUp/AgentFare.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "preinstall": "node dist/preinstall-stop-proxy.js || exit 0",
    "postinstall": "node dist/postinstall-start-proxy.js || exit 0",
    "prepublishOnly": "node ../../scripts/prepublish-check.js"
  },
  "dependencies": {
    "@agentfare/core": "workspace:*",
    "@agentfare/hook": "workspace:*",
    "@agentfare/loader": "workspace:*",
    "@agentfare/models": "workspace:*",
    "@agentfare/proxy": "workspace:*",
    "@agentfare/setup": "workspace:*",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8",
    "vitest": "^3.2"
  }
}
