{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AgentFare",
  "version": "0.1.0",
  "identifier": "com.agentfare.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm -w build && pnpm --filter @agentfare/proxy bundle:daemon && node scripts/assemble-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "AgentFare 控制台",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/": "sidecar/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
