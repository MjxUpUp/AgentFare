registry=https://registry.npmjs.org/
# better-sqlite3 is a native (N-API) optional dep of @agentfare/core. Under
# pnpm's isolated node_modules + Windows directory junctions, Node does not
# realpath the symlinked core package, so core's internal require("better-sqlite3")
# resolves against the consumer's tree and fails (MODULE_NOT_FOUND). Hoisting it
# to the root node_modules makes it reachable from every package. This only
# affects dev (pnpm install); bundled/desktop deployments place it alongside the
# daemon binary directly (no junctions).
public-hoist-pattern[]=*better-sqlite3*
