{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "e2e/**/*.test.ts",
        "packages/**/*.src/**"
      ],
      "outputs": []
    },
    "lint": {
      "cache": false,
      "persistent": false
    }
  }
}
